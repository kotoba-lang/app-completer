{
  "name": "completer-mcp-component-cljs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "shadow-cljs watch app",
    "build": "shadow-cljs compile app",
    "test": "shadow-cljs compile test && node out/tests.js",
    "page": "nbb --classpath \"$(clojure -Spath)\" scripts/gen-page.cljs",
    "page:check": "nbb --classpath \"$(clojure -Spath)\" scripts/gen-page.cljs --check"
  },
  "devDependencies": {
    "shadow-cljs": "2.28.20",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
